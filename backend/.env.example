# Corporate ESG Reporting Portal - Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/esg_portal
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h
DEMO_USER_PASSWORD=replace_with_secure_local_dev_password
